name: big_data

services:
  namenode:
    build:
      context: .
      dockerfile: docker/hadoop/Dockerfile
    image: big_data-namenode:local
    container_name: namenode
    hostname: namenode
    environment:
      HADOOP_ROLE: namenode
    ports:
      - "9870:9870"
      - "9000:9000"
    volumes:
      - namenode-data:/hadoop/dfs/name
    networks:
      - bigdata
    healthcheck:
      test: ["CMD-SHELL", "curl -fs http://localhost:9870/ >/dev/null || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 30
      start_period: 30s

  datanode:
    build:
      context: .
      dockerfile: docker/hadoop/Dockerfile
    image: big_data-datanode:local
    container_name: datanode
    hostname: datanode
    environment:
      HADOOP_ROLE: datanode
    depends_on:
      namenode:
        condition: service_healthy
    ports:
      - "9864:9864"
    volumes:
      - datanode-data:/hadoop/dfs/data
    networks:
      - bigdata
    healthcheck:
      test: ["CMD-SHELL", "curl -fs http://localhost:9864/ >/dev/null || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 30
      start_period: 30s

  resourcemanager:
    build:
      context: .
      dockerfile: docker/hadoop/Dockerfile
    image: big_data-resourcemanager:local
    container_name: resourcemanager
    hostname: resourcemanager
    environment:
      HADOOP_ROLE: resourcemanager
    depends_on:
      namenode:
        condition: service_healthy
      datanode:
        condition: service_started
    ports:
      - "8088:8088"
      - "8032:8032"
    networks:
      - bigdata
    healthcheck:
      test: ["CMD-SHELL", "curl -fs http://localhost:8088/ws/v1/cluster/info >/dev/null || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 30
      start_period: 30s

  nodemanager:
    build:
      context: .
      dockerfile: docker/hadoop/Dockerfile
    image: big_data-nodemanager:local
    container_name: nodemanager
    hostname: nodemanager
    environment:
      HADOOP_ROLE: nodemanager
    depends_on:
      resourcemanager:
        condition: service_healthy
    ports:
      - "8042:8042"
    volumes:
      - nodemanager-local:/hadoop/yarn/local
      - nodemanager-log:/hadoop/yarn/log
    networks:
      - bigdata
    healthcheck:
      test: ["CMD-SHELL", "curl -fs http://localhost:8042/ws/v1/node/info >/dev/null || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 30
      start_period: 30s

  historyserver:
    build:
      context: .
      dockerfile: docker/hadoop/Dockerfile
    image: big_data-historyserver:local
    container_name: historyserver
    hostname: historyserver
    environment:
      HADOOP_ROLE: historyserver
    depends_on:
      namenode:
        condition: service_healthy
      resourcemanager:
        condition: service_healthy
    ports:
      - "19888:19888"
      - "10020:10020"
    networks:
      - bigdata
    healthcheck:
      test: ["CMD-SHELL", "curl -fs http://localhost:19888/ >/dev/null || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 30
      start_period: 45s

  zookeeper:
    image: zookeeper:3.9

    container_name: zookeeper
    hostname: zookeeper

    restart: unless-stopped

    ports:
      - "2181:2181"

    environment:
      ZOO_MY_ID: 1

    volumes:
      - zookeeper-data:/data
      - zookeeper-log:/datalog

    networks:
      - bigdata

    healthcheck:
      test: ["CMD-SHELL", "echo ruok | nc localhost 2181 | grep imok"]
      interval: 20s
      timeout: 10s
      retries: 20

  kafka:
    image: apache/kafka:4.0.0

    container_name: kafka
    hostname: kafka

    ports:
      - "9092:9092"

    environment:
      KAFKA_NODE_ID: 1

      KAFKA_PROCESS_ROLES: broker,controller

      KAFKA_CONTROLLER_LISTENER_NAMES: CONTROLLER

      KAFKA_LISTENERS: PLAINTEXT://:9092,CONTROLLER://:9093

      KAFKA_ADVERTISED_LISTENERS: PLAINTEXT://kafka:9092

      KAFKA_LISTENER_SECURITY_PROTOCOL_MAP: PLAINTEXT:PLAINTEXT,CONTROLLER:PLAINTEXT

      KAFKA_CONTROLLER_QUORUM_VOTERS: 1@kafka:9093

      KAFKA_INTER_BROKER_LISTENER_NAME: PLAINTEXT

      KAFKA_AUTO_CREATE_TOPICS_ENABLE: "true"

      KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR: 1
      KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR: 1
      KAFKA_TRANSACTION_STATE_LOG_MIN_ISR: 1

    volumes:
      - kafka-data:/var/lib/kafka/data

    networks:
      - bigdata

    healthcheck:
      test:
        [
          "CMD-SHELL",
          "/opt/kafka/bin/kafka-topics.sh --bootstrap-server localhost:9092 --list >/dev/null 2>&1"
        ]
      interval: 20s
      timeout: 10s
      retries: 30

  hive-metastore-postgresql:
    image: postgres:16
    container_name: hive-metastore-postgresql
    hostname: hive-metastore-postgresql
    environment:
      POSTGRES_DB: metastore
      POSTGRES_USER: hive
      POSTGRES_PASSWORD: hive
    ports:
      - "5432:5432"
    volumes:
      - postgres-data:/var/lib/postgresql/data
    networks:
      - bigdata
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U hive -d metastore"]
      interval: 10s
      timeout: 5s
      retries: 30
      start_period: 20s

  hive-metastore:
    build:
      context: .
      dockerfile: docker/hive/Dockerfile
    image: big_data-hive-metastore:local
    container_name: hive-metastore
    hostname: hive-metastore
    environment:
      HIVE_ROLE: metastore
    depends_on:
      namenode:
        condition: service_healthy
      hive-metastore-postgresql:
        condition: service_healthy
    ports:
      - "9083:9083"
    networks:
      - bigdata
    healthcheck:
      test: ["CMD-SHELL", "nc -z localhost 9083"]
      interval: 15s
      timeout: 5s
      retries: 40
      start_period: 90s

  hive-server:
    build:
      context: .
      dockerfile: docker/hive/Dockerfile
    image: big_data-hive-server:local
    container_name: hive-server
    hostname: hive-server
    environment:
      HIVE_ROLE: server2
    depends_on:
      hive-metastore:
        condition: service_healthy
    ports:
      - "10000:10000"
      - "10002:10002"
    networks:
      - bigdata
    healthcheck:
      test: ["CMD-SHELL", "nc -z localhost 10000"]
      interval: 15s
      timeout: 5s
      retries: 40
      start_period: 90s

  spark-master:
    build:
      context: .
      dockerfile: docker/spark/Dockerfile
    image: big_data-spark-master:local
    container_name: spark-master
    hostname: spark-master
    environment:
      SPARK_ROLE: master
    depends_on:
      namenode:
        condition: service_healthy
    ports:
      - "7077:7077"
      - "8080:8080"
    networks:
      - bigdata
    healthcheck:
      test: ["CMD-SHELL", "curl -fs http://localhost:8080/ >/dev/null || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 30
      start_period: 45s

  spark-worker:
    build:
      context: .
      dockerfile: docker/spark/Dockerfile
    image: big_data-spark-worker:local
    container_name: spark-worker
    hostname: spark-worker
    environment:
      SPARK_ROLE: worker
    depends_on:
      spark-master:
        condition: service_healthy
    ports:
      - "8081:8081"
    networks:
      - bigdata
    healthcheck:
      test: ["CMD-SHELL", "curl -fs http://localhost:8081/ >/dev/null || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 30
      start_period: 45s

  spark-history:
    build:
      context: .
      dockerfile: docker/spark/Dockerfile
    image: big_data-spark-history:local
    container_name: spark-history
    hostname: spark-history
    environment:
      SPARK_ROLE: history
    depends_on:
      namenode:
        condition: service_healthy
    ports:
      - "18080:18080"
    networks:
      - bigdata
    healthcheck:
      test: ["CMD-SHELL", "curl -fs http://localhost:18080/ >/dev/null || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 30
      start_period: 60s

  pig:
    build:
      context: .
      dockerfile: docker/pig/Dockerfile
    image: big_data-pig:local
    container_name: pig
    hostname: pig
    depends_on:
      namenode:
        condition: service_healthy
      resourcemanager:
        condition: service_healthy
    networks:
      - bigdata
    command: ["tail", "-f", "/dev/null"]

  sqoop:
    build:
      context: .
      dockerfile: docker/sqoop/Dockerfile
    image: big_data-sqoop:local
    container_name: sqoop
    hostname: sqoop
    depends_on:
      namenode:
        condition: service_healthy
      hive-server:
        condition: service_healthy
      hive-metastore-postgresql:
        condition: service_healthy
    networks:
      - bigdata
    command: ["tail", "-f", "/dev/null"]

  hbase:
    build:
      context: .
      dockerfile: docker/hbase/Dockerfile
    image: big_data-hbase:local
    container_name: hbase
    hostname: hbase
    depends_on:
      namenode:
        condition: service_healthy
      zookeeper:
        condition: service_healthy
    ports:
      - "16000:16000"
      - "16010:16010"
      - "16020:16020"
      - "16030:16030"
    networks:
      - bigdata
    healthcheck:
      test: ["CMD-SHELL", "curl -fs http://localhost:16010/ >/dev/null || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 40
      start_period: 90s

  hue:
    image: gethue/hue:latest
    container_name: hue
    hostname: hue
    depends_on:
      namenode:
        condition: service_healthy
      hive-server:
        condition: service_healthy
    ports:
      - "8888:8888"
    volumes:
      - ./config/hue/hue.ini:/usr/share/hue/desktop/conf/hue.ini:ro
    networks:
      - bigdata

  validator:
    build:
      context: .
      dockerfile: docker/validator/Dockerfile
    image: big_data-validator:local
    container_name: validator
    profiles:
      - tools
    depends_on:
      namenode:
        condition: service_healthy
      resourcemanager:
        condition: service_healthy
      spark-master:
        condition: service_healthy
      hive-server:
        condition: service_healthy
      hbase:
        condition: service_healthy
    networks:
      - bigdata

networks:
  bigdata:
    name: bigdata
    driver: bridge

volumes:
  namenode-data:
  datanode-data:
  nodemanager-local:
  nodemanager-log:
  zookeeper-data:
  zookeeper-log:
  kafka-data:
  postgres-data:
